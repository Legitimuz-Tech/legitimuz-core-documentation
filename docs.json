{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Legitimuz",
  "colors": {
    "primary": "#fd7138",
    "light": "#ff8a5c",
    "dark": "#e95619"
  },
  "favicon": "/favicon.svg",
  "fonts": {
    "heading": {
      "family": "Open Runde",
      "weight": 600,
      "source": "/fonts/OpenRunde-Semibold.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "Open Runde",
      "weight": 400,
      "source": "/fonts/OpenRunde-Regular.woff2",
      "format": "woff2"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Comece aqui",
        "icon": "rocket",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "tab": "Documentação",
        "icon": "book-open",
        "groups": [
          {
            "group": "Conceitos",
            "pages": [
              "concepts/how-it-works",
              "concepts/subject-flow",
              "concepts/glossary"
            ]
          },
          {
            "group": "Web SDK",
            "pages": [
              "web-sdk/overview",
              "web-sdk/react",
              "web-sdk/iframe",
              "web-sdk/webview",
              "web-sdk/options",
              "web-sdk/events",
              "web-sdk/errors",
              "web-sdk/security"
            ]
          },
          {
            "group": "Dashboard",
            "pages": [
              "dashboard/getting-started",
              "dashboard/permissions"
            ]
          },
          {
            "group": "Ajuda",
            "pages": [
              "help/faq",
              "help/troubleshooting",
              "help/best-practices",
              "help/certifications"
            ]
          }
        ]
      },
      {
        "tab": "Agentes de IA",
        "icon": "bot",
        "pages": [
          "ai/integration-prompt",
          "ai/mcp"
        ]
      },
      {
        "tab": "Referência",
        "icon": "code",
        "groups": [
          {
            "group": "Comece",
            "pages": [
              "api/overview",
              "api/authentication"
            ]
          },
          {
            "group": "Recursos",
            "pages": [
              "api/verifications",
              "api/verification-statuses",
              "api/webhooks"
            ]
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/errors/:code",
      "destination": "/web-sdk/errors"
    },
    {
      "source": "/ajuda/boas-praticas",
      "destination": "/help/best-practices"
    },
    {
      "source": "/ajuda/faq",
      "destination": "/help/faq"
    },
    {
      "source": "/ajuda/solucao-de-problemas",
      "destination": "/help/troubleshooting"
    },
    {
      "source": "/api/autenticacao",
      "destination": "/api/authentication"
    },
    {
      "source": "/api/verificacoes",
      "destination": "/api/verifications"
    },
    {
      "source": "/api/visao-geral",
      "destination": "/api/overview"
    },
    {
      "source": "/conceitos/como-funciona",
      "destination": "/concepts/how-it-works"
    },
    {
      "source": "/conceitos/fluxo-do-titular",
      "destination": "/concepts/subject-flow"
    },
    {
      "source": "/conceitos/glossario",
      "destination": "/concepts/glossary"
    },
    {
      "source": "/dashboard/primeiros-passos",
      "destination": "/dashboard/getting-started"
    },
    {
      "source": "/ia/mcp",
      "destination": "/ai/mcp"
    },
    {
      "source": "/ia/prompt-de-integracao",
      "destination": "/ai/integration-prompt"
    },
    {
      "source": "/web-sdk/erros",
      "destination": "/web-sdk/errors"
    },
    {
      "source": "/web-sdk/eventos",
      "destination": "/web-sdk/events"
    },
    {
      "source": "/web-sdk/opcoes",
      "destination": "/web-sdk/options"
    },
    {
      "source": "/web-sdk/seguranca",
      "destination": "/web-sdk/security"
    },
    {
      "source": "/web-sdk/visao-geral",
      "destination": "/web-sdk/overview"
    }
  ],
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/legitimuzbr/",
      "instagram": "https://www.instagram.com/legitimuz",
      "youtube": "https://www.youtube.com/@legitimuz"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  }
}
